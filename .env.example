# ==============================================================================
# BAJA RuleBot - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in root or backend/ and fill in your actual credentials.
# NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# AI LLM Provider Configuration (Groq Cloud API Key)
# Get your API key from: https://console.groq.com/keys
API_KEY=your_groq_api_key_here

# Email Notification Configuration (Gmail SMTP for OTP Password Reset)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# MySQL Database Configuration (Local MySQL / Railway / Cloud MySQL)
# Default port for MySQL is usually 3306 (or 3307 if custom)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=your_mysql_password
MYSQL_DATABASE=baja_rulebot

# Optional: Full Database Connection URL (Supported on Railway / Render)
# DATABASE_URL=mysql://root:password@localhost:3306/baja_rulebot
